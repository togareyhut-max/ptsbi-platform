# =============================================================================
# TEMPLATE: salin blok ini ke /home/togaa/wordpress/docker-compose.yml
# Ganti semua placeholder, lalu: docker compose up -d wordpress-SITENAME
# =============================================================================
# Placeholder:
#   SITENAME     = slug: kotakita, ptsbi, lpmpjk
#   DOMAIN       = kotakita.net
#   DB_PASSWORD  = password kuat (sama di MySQL user & WORDPRESS_DB_PASSWORD)
# =============================================================================

  wordpress-SITENAME:
    image: wordpress:6.9.1-php8.2-apache
    container_name: wordpress-SITENAME
    restart: unless-stopped
    environment:
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_NAME: wp_SITENAME
      WORDPRESS_DB_USER: SITENAME
      WORDPRESS_DB_PASSWORD: DB_PASSWORD
    volumes:
      - wordpress_SITENAME:/var/www/html
    networks:
      - traefik
    labels:
      - traefik.enable=true
      # Router utama (apex + www)
      - traefik.http.routers.SITENAME.rule=Host(`DOMAIN`) || Host(`www.DOMAIN`)
      - traefik.http.routers.SITENAME.entrypoints=websecure
      - traefik.http.routers.SITENAME.tls=true
      - traefik.http.routers.SITENAME.tls.certresolver=letsencrypt
      - traefik.http.services.SITENAME.loadbalancer.server.port=80
      # Redirect HTTP -> HTTPS (sesuaikan nama entrypoint jika di traefik pakai "web")
      - traefik.http.routers.SITENAME-http.rule=Host(`DOMAIN`) || Host(`www.DOMAIN`)
      - traefik.http.routers.SITENAME-http.entrypoints=web
      - traefik.http.routers.SITENAME-http.middlewares=SITENAME-redirect
      - traefik.http.middlewares.SITENAME-redirect.redirectscheme.scheme=https
      - traefik.http.middlewares.SITENAME-redirect.redirectscheme.permanent=true

# Tambahkan di bagian volumes: (jika belum ada)
#   wordpress_SITENAME:

# networks di akhir file (harus sudah ada):
# networks:
#   traefik:
#     external: true

