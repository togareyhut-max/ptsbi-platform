# Salin ke .env lalu sesuaikan sebelum docker compose up

POSTGRES_USER=tarombo
POSTGRES_PASSWORD=ganti-password-kuat-min-16-karakter
POSTGRES_DB=tarombo_ptsbi

SECRET_KEY=ganti-dengan-string-acak-panjang-min-32-karakter

# Otomatis diisi docker-compose (jangan ubah host kecuali tahu yang dilakukan)
DATABASE_URL=postgresql://tarombo:ganti-password-kuat-min-16-karakter@postgres:5432/tarombo_ptsbi

# Jangan set USE_SQLITE di production
# USE_SQLITE=0
